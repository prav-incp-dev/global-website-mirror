{
  "name": "ourhouse-mlm",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "tsx server.js --dev",
    "build": "vite build",
    "start": "tsx server.js",
    "db:seed": "tsx prisma/seed.ts",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:test:setup": "tsx scripts/setup-test-db.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:mutation": "npx --yes --package @stryker-mutator/core@^9.6.1 --package @stryker-mutator/vitest-runner@^9.6.1 stryker run",
    "test:mutate:files": "npx -y --package @stryker-mutator/core@^9.6.1 --package @stryker-mutator/vitest-runner@^9.6.1 stryker run --mutate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@fastify/cookie": "^11.1.1",
    "@fastify/csrf-protection": "^8.0.0",
    "@fastify/react": "^1.1.8",
    "@fastify/vite": "^10.0.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.9.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "fastify-cron": "^1.4.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "react-router": "^7.18.2",
    "tsx": "^4.23.1",
    "viem": "^2.55.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "prisma": "^7.9.0",
    "vite": "^8.1.4",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "22.x"
  }
}
