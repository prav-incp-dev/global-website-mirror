# PostgreSQL connection string
DATABASE_URL="postgresql://alice@localhost:5432/ourhouse_mlm"

# Secret used for signing session cookies
SESSION_SECRET="change-me-in-production-super-secret-key"

# Server port (optional, defaults to 3000)
# PORT=3000
BASE_URL=http://localhost:3000

# SMTP (MailCatcher for local dev — run `mailcatcher` before starting the server)
# MailCatcher SMTP: http://localhost:1025 | Web UI: http://localhost:1080
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@ourhouse.app

# BSC Testnet USDT settings for frontend payments
VITE_BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
VITE_BSC_TESTNET_USDT_ADDRESS=0x337610d27c682E347C9cD60BD4b3b107C9d34dDd

# Number of days since lastInteractionDate that makes user stale
STALE_INTERACTION_DAYS=30

# Number of days without closed interaction after which user is untied from parent
UNTIE_DAYS=40
