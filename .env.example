# PostgreSQL connection string
DATABASE_URL="postgresql://alice@localhost:5432/ourhouse_mlm"

# Secret used for signing session cookies
SESSION_SECRET="change-me-in-production-super-secret-key"

# Server port (optional, defaults to 3000)
# PORT=3000
BASE_URL=http://localhost:3000

# SMTP (MailCatcher for local dev — run `mailcatcher` before starting the server)
# MailCatcher SMTP: http://localhost:1025 | Web UI: http://localhost:1080
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@ourhouse.app

VITE_TEST_CHAIN=true

# Local Anvil USDT settings for frontend payments (comment the both lines for using real BSC Testnet)
VITE_BSC_RPC_URL=http://127.0.0.1:8545
VITE_BSC_USDT_ADDRESS=0x700b6A60ce7EaaEA56F065753d8dcB9653dbAD35
VITE_BSC_SPLIT_ADDRESS=0x59b670e9fA9D0A427751Af201D676719a970857b
