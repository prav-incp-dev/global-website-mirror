generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  Admin
  Candidate
  Consultant
}

enum OrderStatus {
  Pending
  Paid
  Canceled
}

enum PaymentStatus {
  Pending
  Completed
  ToRefund
  Refunded
  Canceled
  Failed
  Splitted
}

enum InteractionStatus {
  Open
  Closed
}

model Company {
  id               Int       @id @default(autoincrement())
  name             String    @unique
  wallet           String?   @unique
  serviceWallet    String?   @unique
  cumulativeWallet  String?  @unique
  users            User[]
  settings         Setting[]
  wages            Wage[]
  payments         Payment[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model UsedInvite {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  createdAt DateTime @default(now())
}

model User {
  id                    Int           @id @default(autoincrement())
  email                 String        @unique
  password              String
  role                  UserRole      @default(Candidate)
  companyId             Int
  company               Company       @relation(fields: [companyId], references: [id])
  nick                  String?       @unique
  firstName             String?
  lastName              String?
  phone                 String        @unique
  level                 Int           @default(0)
  levelConfirmed        Boolean       @default(true)
  toReviewLevel         Boolean       @default(false)
  memberId              String?       @unique
  parentId              Int?
  parent                User?         @relation("UserParent", fields: [parentId], references: [id])
  orphant               Boolean       @default(false)
  children              User[]        @relation("UserParent")
  wallet                String?
  confirmationCode      String?
  orders                Order[]
  payments              Payment[]
  wages                 Wage[]
  levelHistories        LevelHistory[]
  initiatedInteractions Interaction[] @relation("InitiatorInteractions")
  targetedInteractions  Interaction[] @relation("TargetInteractions")
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

model Setting {
  id        Int      @id @default(autoincrement())
  general   Json
  levels    Json
  prices    Json
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId])
}

model Wage {
  id              Int            @id @default(autoincrement())
  companyId       Int
  company         Company        @relation(fields: [companyId], references: [id])
  userId          Int?
  user            User?          @relation(fields: [userId], references: [id])
  paymentId       Int?
  payment         Payment?       @relation(fields: [paymentId], references: [id])
  fromWallet      String?
  toWallet        String?
  description     String?
  score           Int            @default(0)
  groupScore      Int            @default(0)
  amount          Decimal        @default(0.00) @db.Decimal(12, 2)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([companyId])
  @@index([userId])
  @@index([paymentId])
}

model Order {
  id          Int         @id @default(autoincrement())
  userId      Int
  user        User        @relation(fields: [userId], references: [id])
  quantity    Int
  totalAmount Decimal     @db.Decimal(12, 2)
  status      OrderStatus @default(Pending)
  payment     Payment?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId])
  @@index([createdAt])
}

model Payment {
  id                Int           @id @default(autoincrement())
  uid               String?       @unique
  orderId           Int           @unique
  order             Order         @relation(fields: [orderId], references: [id])
  userId            Int
  user              User          @relation(fields: [userId], references: [id])
  companyId         Int
  company           Company       @relation(fields: [companyId], references: [id])
  amount            Decimal       @db.Decimal(12, 2)
  tokenSymbol       String        @default("USDT")
  tokenContract     String
  tokenDecimals     Int
  chainId           Int
  txHash            String?       @unique
  fromWallet        String?
  toWallet          String
  status            PaymentStatus @default(Pending)
  refundRequestedAt DateTime?
  refundedAt        DateTime?
  finalized         Boolean       @default(false)
  wages             Wage[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model LevelHistory {
  id        Int      @id @default(autoincrement())
  oldLevel  Int
  newLevel  Int
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId])
}

model Interaction {
  id           Int               @id @default(autoincrement())
  status       InteractionStatus @default(Open)
  plannedAt    DateTime
  completedAt  DateTime?
  description  String
  reminderSent Boolean           @default(false)
  initiatorId  Int?
  initiator    User?             @relation("InitiatorInteractions", fields: [initiatorId], references: [id])
  targetId     Int
  target       User              @relation("TargetInteractions", fields: [targetId], references: [id])
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([initiatorId])
  @@index([targetId])
  @@index([completedAt])
}
